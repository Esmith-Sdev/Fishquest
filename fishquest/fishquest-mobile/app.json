{
  "expo": {
    "name": "FishQuest",
    "slug": "fishquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fishquest-android-icon.png",
    "scheme": "fishquestmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FishQuest needs access to your photo library to upload images for logs.",
        "NSCameraUsageDescription": "FishQuest needs camera access to take photos for logs.",
        "NSLocationWhenInUseUsageDescription": "FishQuest uses your location to autofill the log address and get local weather."
      }
    },
    "android": {
      "package": "com.sdev.esmith.fishquest",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#090040",
        "foregroundImage": "./assets/images/fishquest-android-icon.png",
        "backgroundImage": "./assets/images/fishquest-android-icon.png",
        "monochromeImage": "./assets/images/fishquest-android-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fishquest-android-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fishquest-android-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow FishQuest to use Face ID."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-notifications"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c37be525-7000-4d4d-9d83-68bb5a7677c5"
      }
    }
  }
}
